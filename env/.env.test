# ──────────────────────────────────────────────────────────────────────────────
# SEO Helper — тестовое окружение для локального запуска и CI
#
#   Использование:
#     cp env/.env.test .env
#     docker compose up --build -d
#
#   либо без копирования:
#     docker compose --env-file env/.env.test up --build -d
#
# ⚠️  ЭТО НЕ СЕКРЕТЫ ДЛЯ ПРОДАКШЕНА.
#     Все значения ниже предназначены только для локальной разработки и тестов.
#     Для реального деплоя используйте env/.env.example и сгенерируйте свои ключи.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=seohelper_db
POSTGRES_USER=seohelper
POSTGRES_PASSWORD=seohelper_test_pg

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=seohelper_test_redis

# ── JWT ───────────────────────────────────────────────────────────────────────
# Фиксированный ключ только для тестов: токены переживают перезапуск контейнера.
JWT_SECRET=seohelper-test-jwt-secret-do-not-use-in-production-2026

# ── Google PageSpeed Insights ─────────────────────────────────────────────────
# Пусто — внешний API не вызывается, метрики скорости в тестах не учитываются.
PAGESPEED_API_KEY=

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Пустые значения: письма не отправляются, код подтверждения пишется в лог приложения.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:3b

# ── Отладка ───────────────────────────────────────────────────────────────────
JPA_SHOW_SQL=true
