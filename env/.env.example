# ──────────────────────────────────────────────────────────────────────────────
# SEO Helper — шаблон переменных окружения
#
#   1. Скопируйте файл в корень проекта:  cp env/.env.example .env
#   2. Заполните значения (все CHANGE_ME_* обязательны).
#   3. Запустите:  docker compose up --build -d
#
# Файл .env в корне не попадает в git (см. .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=seohelper_db
POSTGRES_USER=seohelper
# CHANGE_ME: придумайте длинный пароль (например: openssl rand -base64 24)
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
# CHANGE_ME: пароль Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT (обязательно) ─────────────────────────────────────────────────────────
# CHANGE_ME: минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS

# ── Google PageSpeed Insights ─────────────────────────────────────────────────
# Ключ: https://developers.google.com/speed/docs/insights/v5/get-started
# Можно оставить пустым — тогда SEO-аудит без метрик скорости (часть оценки будет 0).
PAGESPEED_API_KEY=

# ── SMTP для писем подтверждения и сброса пароля ──────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# CHANGE_ME: адрес отправителя
MAIL_USERNAME=CHANGE_ME_MAIL_USERNAME@gmail.com
# CHANGE_ME: пароль приложения (не обычный пароль аккаунта!)
MAIL_PASSWORD=CHANGE_ME_MAIL_APP_PASSWORD

# ── Ollama ────────────────────────────────────────────────────────────────────
# Имя модели, которая должна быть загружена: docker compose exec ollama ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# ── Отладка ───────────────────────────────────────────────────────────────────
# Выводить SQL-запросы Hibernate в лог (true/false)
JPA_SHOW_SQL=false
